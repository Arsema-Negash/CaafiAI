# CAAFI_AI environment example — copy to .env and adjust values.
# Do not commit real secrets or production credentials.

# Runtime
PROJECT_NAME=CAAFI_AI
ENVIRONMENT=development
LOG_LEVEL=INFO

# Paths (defaults work for local development from the repository root)
# EMBEDDINGS_FILE=data/embeddings/clinical_chunks.json
# RAW_DATA_DIR=data/raw
# PROCESSED_DATA_DIR=data/processed

# Retrieval limits
DEFAULT_TOP_K=3
MAX_TOP_K=10
MAX_MESSAGE_LENGTH=2000
# Engineering abstention floor for cosine similarity (not a clinical threshold)
MIN_SEMANTIC_SCORE=0.25

# Embedding model — must match the model used to build the index
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
GUIDELINE_SOURCE_NAME=Ethiopian Primary Health Care Clinical Guidelines, 2017
